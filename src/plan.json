        {
          "id": "back-squat",
          "name": "Barbell back squat",
          "sets": 4,
          "reps": "5-8",
          "restSec": 180,
          "note": "Last top ~90\u201392\u00d74\u20135 \u00b7 1\u20132 RIR",
